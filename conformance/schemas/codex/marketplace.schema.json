{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/buchk/TypeFerence/conformance/schemas/codex/marketplace.schema.json",
  "title": "Codex marketplace.json as TypeFerence emits it",
  "description": "The subset of the Codex marketplace index that build writes to .agents/plugins/marketplace.json.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "plugins"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "plugins": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "source",
          "policy",
          "category"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source",
              "path"
            ],
            "properties": {
              "source": {
                "const": "local"
              },
              "path": {
                "type": "string",
                "pattern": "^\\./codex/[a-z0-9]+(-[a-z0-9]+)*$"
              }
            }
          },
          "policy": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "installation",
              "authentication"
            ],
            "properties": {
              "installation": {
                "const": "AVAILABLE"
              },
              "authentication": {
                "const": "ON_INSTALL"
              }
            }
          },
          "category": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
