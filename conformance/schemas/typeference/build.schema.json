{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/buchk/TypeFerence/conformance/schemas/typeference/build.schema.json",
  "title": "TypeFerence build.json",
  "description": "The target's integrity index (.typeference/build.json, schemaVersion 4): one entry per client and built artifact, one per artifact a client does not build, and one per marketplace file.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "target",
    "sourceDigest",
    "artifacts",
    "notBuilt",
    "files"
  ],
  "properties": {
    "schemaVersion": {
      "const": 4
    },
    "target": {
      "const": "agent-plugin"
    },
    "sourceDigest": {
      "$ref": "#/$defs/digest"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "client",
          "id",
          "mode",
          "path",
          "sourceDigest",
          "digest"
        ],
        "properties": {
          "client": {
            "enum": [
              "copilot",
              "claude",
              "codex"
            ]
          },
          "id": {
            "$ref": "#/$defs/id"
          },
          "mode": {
            "enum": [
              "manual",
              "pipeline"
            ]
          },
          "path": {
            "type": "string",
            "pattern": "^(copilot|claude|codex)/[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$"
          },
          "sourceDigest": {
            "$ref": "#/$defs/digest"
          },
          "digest": {
            "$ref": "#/$defs/digest"
          }
        }
      }
    },
    "notBuilt": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "client",
          "id",
          "mode",
          "reason"
        ],
        "properties": {
          "client": {
            "enum": [
              "claude",
              "codex"
            ]
          },
          "id": {
            "$ref": "#/$defs/id"
          },
          "mode": {
            "enum": [
              "manual",
              "pipeline"
            ]
          },
          "reason": {
            "enum": [
              "copilot-components",
              "server-cwd"
            ]
          }
        }
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "source",
          "digest"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "digest": {
            "$ref": "#/$defs/digest"
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]*(/[a-z0-9][a-z0-9.-]*)+@[^@\\s]+$"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
