{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/buchk/TypeFerence/conformance/schemas/claude-code/mcp.schema.json",
  "title": "Claude Code .mcp.json as TypeFerence emits it",
  "description": "The Claude Code adapter's MCP configuration: stdio servers with command, args, and env, and http servers. Plugin variables use Claude Code's names.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mcpServers"
  ],
  "properties": {
    "mcpServers": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)+$"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "command"
            ],
            "properties": {
              "command": {
                "type": "string",
                "minLength": 1,
                "not": {
                  "pattern": "^\\./|\\$\\{PLUGIN_"
                }
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string",
                  "not": {
                    "pattern": "\\$\\{PLUGIN_"
                  }
                }
              },
              "env": {
                "type": "object",
                "additionalProperties": {
                  "type": "string",
                  "not": {
                    "pattern": "\\$\\{PLUGIN_"
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "url"
            ],
            "properties": {
              "type": {
                "const": "http"
              },
              "url": {
                "type": "string",
                "pattern": "^https://"
              },
              "headers": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              }
            }
          }
        ]
      }
    }
  }
}
