{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/buchk/TypeFerence/conformance/schemas/claude-code/plugin.schema.json",
  "title": "Claude Code .claude-plugin/plugin.json as TypeFerence emits it",
  "description": "The subset of the Claude Code plugin manifest that the Claude Code adapter writes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "version",
    "description"
  ],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^(?!.*(?:--|\\.\\.))[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$"
    },
    "version": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "email": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "homepage": {
      "type": "string",
      "minLength": 1
    },
    "repository": {
      "type": "string",
      "minLength": 1
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "keywords": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
